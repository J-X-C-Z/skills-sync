<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jxcz.codex-skills-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/jxcz/Documents/Codex/skills-sync/scripts/sync-installed-skills.sh</string>
  </array>
  <key>WatchPaths</key>
  <array>
    <string>/Users/jxcz/.codex/skills</string>
    <string>/Users/jxcz/Documents/Codex/skills-sync</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/codex-skills-sync.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/codex-skills-sync.log</string>
</dict>
</plist>
